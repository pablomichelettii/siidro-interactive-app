# ==========================================================================
# SIIDRO interactive app — configurazione
#
#   cp .env.example .env     poi riempi quello che ti serve
#
# `npm start` legge .env da solo (Node lo fa in proprio, nessuna dipendenza).
# Se il file non c'è, l'app parte lo stesso con i default qui sotto.
# .env è in .gitignore.
# ==========================================================================

# --- server ---------------------------------------------------------------

# Porta di ascolto.
PORT=3000

# Se impostato, la regia è raggiungibile solo con ?role=director&k=<token>.
# Vuoto = regia libera: va bene in locale, NON in deploy pubblico.
DIRECTOR_TOKEN=


# --- chat moderata --------------------------------------------------------

# 0 disattiva la chat ovunque: la casella sparisce dal telefono e il server
# rifiuta comunque, se un istituto non la vuole.
CHAT_ATTIVA=1

# Tetto sul messaggio. Oltre, il testo viene troncato (non rifiutato).
# 140 è quanto si legge da venti metri: non è un limite tecnico, è il fondo aula.
CHAT_MAX_CHARS=140

# Tra due messaggi dello stesso partecipante.
CHAT_COOLDOWN_MS=5000

# Quanti messaggi in attesa può avere in coda un singolo partecipante.
CHAT_MAX_IN_CODA=2

# Quanto resta a schermo una bolla approvata. Da calibrare in sala col
# proiettore vero: una bolla che passa in 4 secondi, dal fondo, non si legge.
CHAT_BOLLA_MS=12000


# --- loadtest (solo per le prove) ------------------------------------------

# Server contro cui puntare, se non è localhost:3000.
# URL=https://siidro.tuodominio.it

# Forza la serata: una cifra per esempio votabile = indice dell'opzione scelta.
#   000 = tutti sulla prima opzione     012 = uno per opzione
# SCENARIO=
