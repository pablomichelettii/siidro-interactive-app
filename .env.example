# ==========================================================================
# Il Libro Vivo del 2040 — configurazione
#
#   cp .env.example .env     poi riempi quello che ti serve
#
# `npm start` legge .env da solo (Node lo fa in proprio, nessuna dipendenza).
# Se il file non c'è, l'app parte lo stesso con i default qui sotto.
# .env è in .gitignore: la chiave non finisce nel repo.
# ==========================================================================

# --- server ---------------------------------------------------------------

# Porta di ascolto.
PORT=3000

# Se impostato, la regia è raggiungibile solo con ?role=director&k=<token>.
# Vuoto = regia libera: va bene in locale, NON in deploy pubblico.
DIRECTOR_TOKEN=


# --- epilogo individuale (OpenRouter) --------------------------------------

# La chiave. Senza, la serata funziona lo stesso: tutti ricevono uno dei sei
# fallback pre-scritti. Ma attenzione — i fallback dipendono solo dalla banda
# dell'Indice e dall'esito del climax, che sono proprietà DELLA SALA: senza
# chiave tutti gli studenti della stessa sala leggono lo stesso identico testo.
OPENROUTER_API_KEY=

# Lo slug del modello sul catalogo OpenRouter.
# ⚠️ DA CONFERMARE: se lo slug non esiste la chiamata fallisce in silenzio e
# vanno tutti in fallback. Verifica con:  npm run epiloghi
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Endpoint OpenAI-compatibile. Da cambiare solo per puntare altrove.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Oltre questo tempo, l'epilogo di quello studente diventa il fallback.
EPILOGO_TIMEOUT_MS=60000

# Tetto su RAGIONAMENTO + TESTO, non solo sul testo. I modelli che ragionano
# spendono 400-550 token prima di scrivere una parola: misurato, sotto i 2000
# un epilogo su quattro esce troncato a metà frase. È un tetto, non una
# prenotazione: si paga solo quello che viene consumato davvero.
EPILOGO_MAX_TOKENS=4000

# Chiamate simultanee. I 9 minuti del capitolo 13 bastano e avanzano con 6;
# alzare solo se in prova risulta lento, e sapendo che si rischia un 429.
EPILOGO_PARALLELE=6


# --- persistenza degli epiloghi --------------------------------------------

# Dove finiscono gli epiloghi rileggibili dal link /e/<token>.
# A disco vanno nome, stringa dell'età e testo. La data di nascita no.
EPILOGHI_DIR=data/epiloghi

# Dopo quanti giorni i file vengono cancellati, all'avvio del server.
EPILOGHI_RETENTION_GIORNI=30


# --- loadtest (solo per le prove) ------------------------------------------

# Server contro cui puntare, se non è localhost:3000.
# URL=https://libro.tuodominio.it

# Forza la serata: 12 lettere f/d, una per capitolo.
#   ffffffffffff = sei esiti negativi     dddddddddddd = sei positivi
#   ffffffdddddd = si pente a metà        ddddddffffff = si stanca a metà
# SCENARIO=
